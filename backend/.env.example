# ─── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─── Database (SQLite — no separate service needed) ────────────────────────────
DATABASE_URL="file:./dev.db"

# ─── Email (SMTP) ──────────────────────────────────────────────────────────────
# Gmail: enable 2FA → Google Account → Security → App passwords → create one
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=sandghos1987@gmail.com
SMTP_PASS=amvl hkqr drhl areu

# ─── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=*

# ─── Runtime config (managed via API, not env vars) ───────────────────────────
# All of the following are configured at runtime via PUT /api/config:
#   notificationEmail  — email address to receive notifications
#   watchedRepo        — GitHub repo to watch (default: Expensify/App)
#   watchedLabel       — label to filter on  (default: Help Wanted)
#   issueLimit         — max new issues/day  (default: 4)
#   githubToken        — optional PAT for higher rate limits
