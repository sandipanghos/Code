# ─── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001

# ─── Database ──────────────────────────────────────────────────────────────────
# SQLite for local dev:
DATABASE_URL="file:./dev.db"
# PostgreSQL for production (uncomment and fill in):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# ─── Redis (BullMQ job queue) ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# Upstash for production (uncomment and fill in):
# REDIS_URL=rediss://default:TOKEN@HOST:PORT

# ─── JWT Auth ──────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_generate_a_random_64_char_hex_string
JWT_REFRESH_SECRET=CHANGE_ME_another_random_64_char_hex_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── GitHub ────────────────────────────────────────────────────────────────────
# Personal Access Token (classic) with scopes: repo, read:issues, write:discussion
GITHUB_TOKEN=ghp_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
GITHUB_REPO_OWNER=Expensify
GITHUB_REPO_NAME=App

# ─── Email (Gmail SMTP) ────────────────────────────────────────────────────────
# Enable 2FA on Gmail first, then create an App Password at:
# Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# ─── Security ──────────────────────────────────────────────────────────────────
# AES-256 key for encrypting GitHub tokens in DB
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ENCRYPTION_KEY=CHANGE_ME_32_hex_chars_exactly_here

# Allowed frontend origin for CORS
CORS_ORIGIN=http://localhost:3000

# ─── Scheduler ─────────────────────────────────────────────────────────────────
POLL_INTERVAL_MINUTES=1
PROPOSAL_CHECK_INTERVAL_MINUTES=30
GRACE_PERIOD_HOURS=24
